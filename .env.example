# Copy to .env.local and fill in from your Supabase project. Everything here is optional:
# without it the timer works as normal, and focus_room / rooms show as offline or unavailable.

# Realtime (focus_room count and rooms). Project Settings → API.
# The publishable key (sb_publishable_…) or the legacy anon key both work. Never put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Postgres via Prisma (rooms only). Connect → ORMs → Prisma in the Supabase dashboard.
# The app uses the transaction pooler (port 6543)...
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
# ...and `npm run db:deploy` (prisma migrate deploy) uses the session pooler (port 5432) or the direct connection.
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
