# Supabase project used by focus_room (Realtime Presence only, no tables).
# Copy to .env.local and fill in from Project Settings → API in the Supabase dashboard.
# The publishable key (sb_publishable_…) or the legacy anon key both work. Never put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
